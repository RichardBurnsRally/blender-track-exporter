# Dev tooling venv (black, mypy, headless bpy for the smoke test), kept
# fresh via a stamp; scripts/check.sh and scripts/smoke.sh then work as-is.
watch_file .python-version requirements-dev.txt
if scripts/ensure-venv.sh; then
  PATH_add .venv/bin
else
  log_error "dev venv setup failed - run scripts/ensure-venv.sh manually"
fi
